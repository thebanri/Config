[Unit]
Description=NVIDIA GPU clock lock (core 600-2100 MHz, min P5)
After=nvidia-persistenced.service
Wants=nvidia-persistenced.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/nvidia-smi -pm 1
ExecStart=/usr/bin/nvidia-smi -lgc 600,2100
ExecStart=/usr/bin/nvidia-smi -lmc 810,7501
ExecStop=/usr/bin/nvidia-smi -rgc
ExecStop=/usr/bin/nvidia-smi -rmc

[Install]
WantedBy=multi-user.target
