#!/usr/bin/env bash
# Çekirdeğin clocksource uyarılarını izler ve gerektiğinde masaüstü bildirimi gönderir.
# "Watchdog remote CPU N read timed out" / "Long readout interval" zararsızdır: çekirdek
# o turu atlar, TSC'yi bırakmaz. Bunlar sadece log'a yazılır; bildirim şu durumlarda gelir:
#   - çekirdek TSC'yi "unstable" işaretlerse / skew raporlarsa / başka saat kaynağına geçerse
#   - bu açılışta zararsız timeout'lar THRESHOLD sayısına ulaşırsa (sürekli tekrar ediyorsa)

THRESHOLD=5
LOG="$HOME/.local/state/clocksource-watch.log"
CUR=/sys/devices/system/clocksource/clocksource0/current_clocksource
mkdir -p "$(dirname "$LOG")"

log() {
    echo "$(date '+%F %T')  $1" >> "$LOG"
}

notify() {
    log "BİLDİRİM: $1"
    notify-send -u critical -a "Clocksource" -i dialog-warning "Saat kaynağı uyarısı" "$1"
}

is_benign() {
    [[ $1 == *"read timed out"* || $1 == *"Long readout interval"* ]]
}

is_critical() {
    [[ $1 == *unstable* || $1 == *skew* ]] ||
        { [[ $1 == *"Switched to clocksource"* ]] && [[ $(<"$CUR") != tsc ]]; }
}

boot_lines=$(journalctl -b -k -q -o cat --grep 'clocksource' 2>/dev/null)
count=$(grep -cE 'read timed out|Long readout interval' <<< "$boot_lines")
notified=0
if [[ $(<"$CUR") != tsc ]]; then
    notify "Saat kaynağı TSC değil: $(<"$CUR")"
elif grep -qE 'unstable|skew' <<< "$boot_lines"; then
    notify "Bu açılışta: $(grep -E 'unstable|skew' <<< "$boot_lines" | head -1)"
elif (( count >= THRESHOLD )); then
    notify "Bu açılışta $count clocksource watchdog timeout'u var."
    notified=1
fi

journalctl -kf -n0 -q -o cat --grep 'clocksource' | while read -r line; do
    if is_critical "$line"; then
        notify "$line"
    elif is_benign "$line"; then
        (( count++ ))
        log "$line ($count. kez bu açılışta)"
        if (( count >= THRESHOLD && ! notified )); then
            notify "Bu açılışta $count clocksource watchdog timeout'u oldu (son: $line)"
            notified=1
        fi
    else
        log "$line"
    fi
done
