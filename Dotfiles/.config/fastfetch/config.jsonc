{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "~/.config/fastfetch/arch_big.txt",
    "type": "file",
    "color": {
      "1": "cyan"
    },
    "padding": {
      "top": 0,
      "right": 3
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "cyan"
    },
    "size": {
      "ndigits": 2
    },
    "percent": {
      "type": 3
    }
  },
  "modules": [
    "break",
    "break",
    {
      "type": "custom",
      "format": "{#36}╭───────────╮"
    },
    {
      "type": "title",
      "format": "{user-name}",
      "key": "│  user    │"
    },
    {
      "type": "os",
      "format": "{name} {arch}",
      "key": "│ 󰣇 distro  │"
    },
    {
      "type": "kernel",
      "format": "{release}",
      "key": "│  kernel  │"
    },
    {
      "type": "uptime",
      "key": "│  uptime  │"
    },
    {
      "type": "packages",
      "format": "{all}",
      "key": "│ 󰏖 pkgs    │"
    },
    {
      "type": "de",
      "format": "{pretty-name} {version}",
      "key": "│  de      │"
    },
    {
      "type": "terminal",
      "format": "{pretty-name}",
      "key": "│  term    │"
    },
    {
      "type": "shell",
      "format": "{pretty-name} {version}",
      "key": "│  shell   │"
    },
    {
      "type": "cpu",
      "temp": true,
      "format": "{name}  {temperature}",
      "key": "│  cpu     │"
    },
    {
      "type": "gpu",
      "temp": true,
      "driverSpecific": true,
      "format": "{name}  {temperature}",
      "key": "│ 󰢮 gpu     │"
    },
    {
      "type": "memory",
      "format": "{used} / {total} ({percentage})",
      "key": "│ 󰍛 memory  │"
    },
    {
      "type": "disk",
      "folders": "/",
      "format": "{size-used} / {size-total} ({size-percentage})",
      "key": "│ 󰋊 disk    │"
    },
    {
      "type": "colors",
      "symbol": "circle",
      "key": "│  colors  │"
    },
    {
      "type": "custom",
      "format": "{#36}╰───────────╯"
    }
  ]
}